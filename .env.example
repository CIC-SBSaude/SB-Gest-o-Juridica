# ============================================================
# SB Gestão Jurídica - VARIÁVEIS DE AMBIENTE (MODELO)
# ============================================================
# Para obter as URLs e chaves da instância local do Supabase CLI, execute:
#   npx supabase status
#
# Copie este arquivo para .env (ou .env.local) e preencha os valores:
#   cp .env.example .env

# --- SUPABASE FRONTEND (Públicas: entram no bundle Vite) ---
# A URL deve apontar para o Kong API Gateway (porta 57321 na configuração local)
# Exemplo local: "http://192.168.91.103:57321" ou "http://127.0.0.1:57321"
VITE_SUPABASE_URL="http://192.168.91.103:57321"
# Chave Publishable / Anon obtida via `npx supabase status` (anon key)
VITE_SUPABASE_PUBLISHABLE_KEY="<SUA_CHAVE_ANON_LOCAL_OBTIDA_VIA_SUPABASE_STATUS>"

# --- SUPABASE BACKEND (Segredos: acessados exclusivamente pelo Node.js) ---
# URL interna acessível pelo backend Express
SUPABASE_URL="http://127.0.0.1:57321"
# Chave Service Role obtida via `npx supabase status` (NUNCA exponha no frontend)
SUPABASE_SECRET_KEY="<SUA_CHAVE_SERVICE_ROLE_LOCAL_OBTIDA_VIA_SUPABASE_STATUS>"

# --- SERVIÇO DE IA (GEMINI) ---
# Chave de API Google Gemini usada estritamente no backend
GEMINI_API_KEY="<SUA_CHAVE_GEMINI_API_KEY>"

# --- INTEGRAÇÃO IMAP ---
# Senha de aplicativo da conta corporativa juridico.dev@opsaudebrasil.com.br
IMAP_LOGIN_PASSWORD="<SENHA_OU_SENHA_DE_APLICATIVO_IMAP>"

# --- CRIPTOGRAFIA DE CREDENCIAIS (BACKEND) ---
# Chave secreta de 32 bytes (hex ou string aleatória) para AES-256-GCM das credenciais IMAP no banco
EMAIL_CREDENTIALS_ENCRYPTION_KEY="<CHAVE_SECRETA_DE_32_BYTES_HEX_OU_BASE64>"

# --- AMBIENTE DE EXECUÇÃO ---
NODE_ENV="development"
